 242          // HINT: This library contains some nasty hacks to work around bugs in CH559.
 243          // Enabling SOF interrupts makes interrupt transfers fail, since the SOF triggers UIF_TRANSFER (all enpoin
             -ts respond with NAK while UIF_TRANSFER is set).
 244          // When a notification needs to be sent the SOF interrupts are disabled so that the interrupt transfer can
             - happen.
 245          // SOF interrupts are re-enabled after the interrupt transfer completes.
 246          void cdc_on_sof(void)
 247          { 
 248   1        // check for timeout, if the buffer is not being written to then enable transmitting and mark the buffer 
             -as full
 249   1        if(((sof_count - cdc_last_data_time) >= CDC_TIMEOUT_MS) && !(ep3_wip | cdc_tx_enabled))
 250   1        {
 251   2          if(ep3_write_select)
 252   2          {
 253   3            usb_set_ep3_tx_len(ep3_t1_num_bytes);
 254   3            ep3_t1_num_bytes = CDC_ENDP3_SIZE;
 255   3            ep3_write_select = 0;
 256   3          }
 257   2          else
 258   2          {
 259   3            usb_set_ep3_tx_len(ep3_t0_num_bytes);
 260   3            ep3_t0_num_bytes = CDC_ENDP3_SIZE;
 261   3            ep3_write_select = 1;
 262   3          }
 263   2          usb_set_ep3_in_res(USB_IN_RES_EXPECT_ACK);
 264   2          cdc_tx_enabled = 1;
 265   2        }
 266   1          
 267   1        if((sof_count - cdc_last_status_time) >= CDC_TIMEOUT_MS)
 268   1        {
 269   2          usb_set_ep1_tx_len(CDC_SERIAL_STATE_SIZE);
 270   2          usb_set_ep1_in_res(USB_IN_RES_EXPECT_ACK);
 271   2          usb_disable_interrupts(USB_INT_SOF);
 272   2        }
 273   1      }
