 200          #if CDC_USE_UNIQUE_ID
 201          void cdc_gen_string_serial(UINT8 len)
 202          {
 203   1        UINT8* dest = ep0_buffer;
 204   1        UINT16 chip_id;
 205   1        UINT8 id_hex;
 206   1        while(len && (cdc_string_serial_offset < 2))
 207   1        {
 208   2          *dest = cdc_string_serial[cdc_string_serial_offset];
 209   2          dest += 1;
 210   2          cdc_string_serial_offset += 1;
 211   2          len -= 1;
 212   2        }
 213   1        
 214   1        while(len)
 215   1        {
 216   2          if(cdc_string_serial_offset & 0x01)
 217   2          {
 218   3            *dest = 0x00;
 219   3          }
 220   2          else
 221   2          {
 222   3            E_DIS = 1;  //Swap out the code flash for the read only region that contains the chip ID
 223   3            chip_id = (0x0020 + ((cdc_string_serial_offset - 2) >> 2));
 224   3            id_hex = *((UINT8 code*)chip_id);
 225   3            E_DIS = 0;
 226   3            if((cdc_string_serial_offset >> 1) & 0x01)
 227   3              id_hex = id_hex >> 4;
 228   3            id_hex &= 0x0F;
 229   3            if(id_hex < 10)
 230   3              id_hex += '0';
 231   3            else
 232   3              id_hex += 'A' - 10;
 233   3            *dest = id_hex;
 234   3          }
 235   2          dest += 1;
 236   2          cdc_string_serial_offset += 1;
 237   2          len -= 1;
 238   2        }
 239   1      }
