 188          void cdc_copy_descriptor(UINT8 len)
 189          {
 190   1        UINT8* dest = ep0_buffer;
 191   1        while(len)
 192   1        {
 193   2          *dest = *descriptor_ptr;
 194   2          ++dest;
 195   2          ++descriptor_ptr;
 196   2          --len;
 197   2        }
 198   1      }
