  13          // HINT: Enabling SOF interrupts makes SOF tokens trigger UIF_TRANSFER. This breaks interrupt transfers, a
             -nd any other transfers that happen immediately after a SOF
  14          void usb_isr(void) interrupt INT_NO_USB
  15          {
  16   1        if(UIF_TRANSFER)
  17   1        {
  18   2          switch(USB_INT_ST & MASK_UIS_TOKEN)
  19   2          {
  20   3            case UIS_TOKEN_OUT:
  21   3              if(usb_out_callback)
  22   3                usb_out_callback(USB_INT_ST & MASK_UIS_ENDP);
  23   3              break;
  24   3            case UIS_TOKEN_SOF:
  25   3              ++sof_count;
  26   3              if(usb_sof_callback)
  27   3                usb_sof_callback();
  28   3              break;
  29   3            case UIS_TOKEN_IN:
  30   3              if(usb_in_callback)
  31   3                usb_in_callback(USB_INT_ST & MASK_UIS_ENDP);
  32   3              break;
  33   3            case UIS_TOKEN_SETUP:
  34   3              if(usb_setup_callback)
  35   3                usb_setup_callback(USB_INT_ST & MASK_UIS_ENDP);
  36   3              break;
  37   3            default:
  38   3              break;
  39   3          }
  40   2          UIF_TRANSFER = 0;
  41   2        }
  42   1        if(UIF_BUS_RST)
  43   1        {
  44   2          if(usb_rst_callback)
  45   2            usb_rst_callback();
  46   2          USB_DEV_AD = 0x00;
  47   2          UIF_SUSPEND = 0;
  48   2          UIF_TRANSFER = 0;
  49   2          UIF_BUS_RST = 0;
  50   2        }
  51   1        if(UIF_SUSPEND)
  52   1        {
  53   2          UIF_SUSPEND = 0;
